{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obstruction-ledger/schemas/fixture.schema.json",
  "title": "Fixture directory index",
  "description": "One index.json per fixtures/<check>/ or tests/harness/fixtures/<check>/ directory.",
  "type": "object",
  "required": ["check_id", "cases"],
  "additionalProperties": false,
  "properties": {
    "check_id": { "type": "string", "minLength": 1 },
    "measurements_path": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "class", "content_hash"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "class": {
            "enum": [
              "positive",
              "negative",
              "hard_negative",
              "canary",
              "out_of_scope",
              "adversarial"
            ]
          },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
